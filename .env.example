# GitHub App identifiers (see docs/INITIAL.md Step 1)
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=

# OAuth consent local server (Step 2)
OAUTH_CALLBACK_HOST=localhost
OAUTH_CALLBACK_PORT=8765

# Broker server (Step 3)
BROKER_HOST=localhost
BROKER_PORT=9000

# Broker validation rules (Step 3)
OIDC_ISSUER=https://token.actions.githubusercontent.com
OIDC_AUDIENCE=poc-broker
EXPECTED_REPOSITORY=tbrandenburg-bosch/oidc-broker
EXPECTED_REF=refs/heads/CHANGE_ME_FEATURE_BRANCH
ALLOWED_ACTOR_IDS=

# Local storage of the user's refresh token, keyed by GitHub user id
REFRESH_TOKEN_STORE_PATH=./.data/refresh_tokens.json

# ngrok tunnel (Step 4) — read automatically by the ngrok agent, no config
# file needed. Get one at https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=

